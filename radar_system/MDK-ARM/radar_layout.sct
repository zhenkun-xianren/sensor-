; STM32F103C8T6: all load bytes below 0x0800F800; last two pages reserved.
LR_IROM1 0x08000000 0x0000F800 {
  ER_IROM1 0x08000000 0x0000F800 {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00005000 {
    bsp_flash.o (FLASH_RAMCODE)
    .ANY (+RW +ZI)
  }
}
